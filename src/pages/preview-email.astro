---
import { render } from '@react-email/render';
import JeylaPurchaseConfirmationEmail from '@/templates/jeyla/emails/purchase-confirmation';

const mockData = {
  siteName: 'Julieth Garcia',
  productName: 'Plan de Entrenamiento 12 Semanas',
  productDescription:
    'Programa completo de entrenamiento con rutinas diarias, guia de nutricion y seguimiento de progreso para transformar tu cuerpo.',
  buyerEmail: 'maria.lopez@ejemplo.com',
  purchaseCode: 'JG-2026-XK7M',
  downloadToken: 'tok_a1b2c3d4e5f6',
  downloadUrl: 'https://juliethgarcia.com/downloads/tok_a1b2c3d4e5f6',
  amount: 4900000,
  currency: 'COP',
  expiresAt: new Date('2026-03-15'),
  maxDownloads: 5,
};

const emailHtml = await render(JeylaPurchaseConfirmationEmail(mockData));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Preview - Email de Confirmacion de Compra</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background-color: #f5f5f5;
      }
      .toolbar {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 12px 20px;
        background: #5A4A42;
        color: white;
        font-size: 14px;
      }
      .toolbar-title {
        font-weight: 600;
        margin-right: auto;
      }
      .toolbar-badge {
        background: #FFDAB9;
        color: #5A4A42;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
      }
      .preview-frame {
        width: 100%;
        border: none;
        min-height: 100vh;
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <span class="toolbar-title">Email Preview</span>
      <span class="toolbar-badge">Jeyla Template</span>
      <span class="toolbar-badge">Confirmacion de Compra</span>
    </div>
    <iframe
      class="preview-frame"
      srcdoc={emailHtml}
      title="Email Preview"
    ></iframe>
    <script>
      const iframe = document.querySelector('.preview-frame');
      if (iframe) {
        iframe.addEventListener('load', () => {
          const body = iframe.contentDocument?.body;
          if (body) {
            iframe.style.height = body.scrollHeight + 40 + 'px';
          }
        });
      }
    </script>
  </body>
</html>
