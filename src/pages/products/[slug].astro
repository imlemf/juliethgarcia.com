---
import Layout from '@/layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import { getDb } from '@/lib/db';
import { products } from '@/db/schema';
import { eq } from 'drizzle-orm';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/products');
}

const db = getDb(Astro.locals.runtime);

// Get product by slug
const [product] = await db
  .select()
  .from(products)
  .where(eq(products.slug, slug))
  .limit(1);

if (!product || !product.isActive) {
  return Astro.redirect('/products');
}

const title = product.name;
const description = product.description || 'Producto digital';
const priceFormatted = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: product.currency || 'USD',
}).format((product.price || 0) / 100);
---

<Layout title={title} description={description}>
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <a href="/products" class="text-primary hover:underline mb-4 inline-block">
          ← Volver a productos
        </a>
      </div>

      <div class="border rounded-lg overflow-hidden bg-card">
        <div class="p-8">
          <h1 class="text-4xl font-bold mb-4">{product.name}</h1>

          {product.description && (
            <p class="text-muted-foreground text-lg mb-8 whitespace-pre-wrap">
              {product.description}
            </p>
          )}

          <div class="flex items-center justify-between mb-8 p-6 bg-muted rounded-lg">
            <div>
              <p class="text-sm text-muted-foreground mb-1">Precio</p>
              <p class="text-3xl font-bold">{priceFormatted}</p>
            </div>
            <a href={`/products/${product.slug}/checkout`}>
              <Button size="lg" class="text-lg px-8">
                Comprar ahora
              </Button>
            </a>
          </div>

          <div class="border-t pt-8">
            <h3 class="text-xl font-semibold mb-4">¿Qué incluye?</h3>
            <ul class="space-y-2 text-muted-foreground">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-primary mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Descarga inmediata después del pago
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-primary mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Hasta 5 descargas por compra
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-primary mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Acceso por 48 horas desde la compra
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-primary mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Pago seguro con Mercado Pago
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
