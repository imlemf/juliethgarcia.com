---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { PurchasesTable } from '@/components/admin/purchases-table';

const title = 'Compras - Admin';
---

<AdminLayout title={title}>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold">Compras</h1>
      <p class="text-muted-foreground mt-2">
        Visualiza todas las compras de tus clientes
      </p>
    </div>

    <PurchasesTable client:load />
  </div>
</AdminLayout>
