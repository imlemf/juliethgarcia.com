---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { SubscribersTable } from '@/components/admin/subscribers-table';

const title = 'Newsletter - Admin';
---

<AdminLayout title={title}>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold">Newsletter</h1>
      <p class="text-muted-foreground mt-2">
        Gestiona los suscriptores del newsletter
      </p>
    </div>

    <SubscribersTable client:load />
  </div>
</AdminLayout>
