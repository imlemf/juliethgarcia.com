---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { ReferralLinkForm } from '@/components/admin/referral-link-form';

const title = 'Editar Link Referido - Admin';
const { id } = Astro.params;
---

<AdminLayout title={title}>
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold">Editar Link</h1>
      <p class="text-muted-foreground mt-2">
        Modifica los datos del link de afiliado
      </p>
    </div>

    <ReferralLinkForm linkId={id} client:load />
  </div>
</AdminLayout>
