---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
import { PersonCategoriesTable } from '@/components/admin/person-categories-table';

const title = 'Categorías de personas - Admin';
---

<AdminLayout title={title}>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold">Categorías de personas</h1>
        <p class="text-muted-foreground mt-2">
          Organiza las personas por categorías
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/admin/people"
          class="inline-flex items-center gap-2 rounded-md border px-4 py-2 text-sm font-medium hover:bg-muted transition-colors"
        >
          <Icon name="lucide:arrow-left" class="h-4 w-4" />
          Volver a personas
        </a>
        <a
          href="/admin/people/categories/new"
          class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          <Icon name="lucide:plus" class="h-4 w-4" />
          Nueva categoría
        </a>
      </div>
    </div>

    <PersonCategoriesTable client:load />
  </div>
</AdminLayout>
