---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
import { PersonForm } from '@/components/admin/person-form';

const title = 'Nueva persona - Admin';
---

<AdminLayout title={title}>
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a
        href="/admin/people"
        class="inline-flex items-center justify-center rounded-md border h-10 w-10 hover:bg-muted transition-colors"
      >
        <Icon name="lucide:arrow-left" class="h-4 w-4" />
      </a>
      <div>
        <h1 class="text-3xl font-bold">Nueva persona</h1>
        <p class="text-muted-foreground mt-1">
          Agrega una nueva persona al equipo
        </p>
      </div>
    </div>

    <PersonForm client:load />
  </div>
</AdminLayout>
