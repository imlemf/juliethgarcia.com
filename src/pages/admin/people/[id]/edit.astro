---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
import { PersonForm } from '@/components/admin/person-form';

const { id } = Astro.params;
const title = 'Editar persona - Admin';
---

<AdminLayout title={title}>
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a
        href="/admin/people"
        class="inline-flex items-center justify-center rounded-md border h-10 w-10 hover:bg-muted transition-colors"
      >
        <Icon name="lucide:arrow-left" class="h-4 w-4" />
      </a>
      <div>
        <h1 class="text-3xl font-bold">Editar persona</h1>
        <p class="text-muted-foreground mt-1">
          Modifica los datos de la persona
        </p>
      </div>
    </div>

    <PersonForm personId={id} client:load />
  </div>
</AdminLayout>
