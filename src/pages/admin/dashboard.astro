---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/db';
import { users, products, siteLinks, purchases, newsletterSubscribers, blogs, referralLinks, coupons, offers } from '@/db/schema';
import { count, eq, and } from 'drizzle-orm';

const title = 'Dashboard - Admin';
const user = Astro.locals.user;

const db = getDb(Astro.locals.runtime);

const [
  [productsCount],
  [linksCount],
  [usersCount],
  [purchasesCount],
  [subscribersCount],
  [blogsCount],
  [referralLinksCount],
  [couponsCount],
  [offersCount],
] = await Promise.all([
  db.select({ count: count() }).from(products).where(eq(products.isActive, true)),
  db.select({ count: count() }).from(siteLinks).where(eq(siteLinks.isActive, true)),
  db.select({ count: count() }).from(users).where(and(eq(users.role, 'user'), eq(users.isActive, true))),
  db.select({ count: count() }).from(purchases),
  db.select({ count: count() }).from(newsletterSubscribers).where(eq(newsletterSubscribers.status, 'active')),
  db.select({ count: count() }).from(blogs).where(eq(blogs.isPublished, true)),
  db.select({ count: count() }).from(referralLinks).where(eq(referralLinks.isActive, true)),
  db.select({ count: count() }).from(coupons).where(eq(coupons.isActive, true)),
  db.select({ count: count() }).from(offers).where(eq(offers.isActive, true)),
]);
---

<AdminLayout title={title}>
  <div class="max-w-5xl mx-auto space-y-8">
    <div>
      <h1 class="text-3xl font-bold">Dashboard</h1>
      <p class="text-muted-foreground mt-1">
        Bienvenido, {user.name || user.email}
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <div class="rounded-lg border bg-card p-4">
        <p class="text-sm text-muted-foreground">Productos</p>
        <p class="text-2xl font-bold">{productsCount.count}</p>
      </div>
      <div class="rounded-lg border bg-card p-4">
        <p class="text-sm text-muted-foreground">Artículos</p>
        <p class="text-2xl font-bold">{blogsCount.count}</p>
      </div>
      <div class="rounded-lg border bg-card p-4">
        <p class="text-sm text-muted-foreground">Links</p>
        <p class="text-2xl font-bold">{linksCount.count}</p>
      </div>
      <div class="rounded-lg border bg-card p-4">
        <p class="text-sm text-muted-foreground">Links Referidos</p>
        <p class="text-2xl font-bold">{referralLinksCount.count}</p>
      </div>
      <div class="rounded-lg border bg-card p-4">
        <p class="text-sm text-muted-foreground">Cupones</p>
        <p class="text-2xl font-bold">{couponsCount.count}</p>
      </div>
      <div class="rounded-lg border bg-card p-4">
        <p class="text-sm text-muted-foreground">Ofertas</p>
        <p class="text-2xl font-bold">{offersCount.count}</p>
      </div>
      <div class="rounded-lg border bg-card p-4">
        <p class="text-sm text-muted-foreground">Usuarios</p>
        <p class="text-2xl font-bold">{usersCount.count}</p>
      </div>
      <div class="rounded-lg border bg-card p-4">
        <p class="text-sm text-muted-foreground">Compras</p>
        <p class="text-2xl font-bold">{purchasesCount.count}</p>
      </div>
      <div class="rounded-lg border bg-card p-4">
        <p class="text-sm text-muted-foreground">Suscriptores</p>
        <p class="text-2xl font-bold">{subscribersCount.count}</p>
      </div>
    </div>
  </div>
</AdminLayout>
