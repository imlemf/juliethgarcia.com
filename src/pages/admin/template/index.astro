---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { TemplateConfigForm } from '@/components/admin/template-config-form';

const title = 'Plantilla - Admin';
---

<AdminLayout title={title}>
  <div class="max-w-4xl mx-auto space-y-6">
    <div>
      <h1 class="text-3xl font-bold">Plantilla del Sitio</h1>
      <p class="text-muted-foreground mt-2">
        Selecciona y personaliza la plantilla de tu sitio
      </p>
    </div>

    <TemplateConfigForm client:load />
  </div>
</AdminLayout>
