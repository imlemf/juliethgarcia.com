{
  "name": "juliethgarcia-com",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-01-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // D1 Database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juliethgarcia-com",
      "database_id": "56cb60b4-a5cc-4daa-ace0-e48170ea77f2",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // R2 Bucket for digital products storage
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "juliethgarcia-com"
    }
  ]
}